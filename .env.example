# =============================================================================
# Neuro ICU Scheduler - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Browser client. The anon key is safe to ship: every table has RLS enabled and
# policies are granted to the `authenticated` role, so an anon client can read
# nothing until a user signs in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API server (server.js). The server acts for the whole department and holds no
# end-user session, so it must use the SERVICE ROLE key — RLS grants the `anon`
# role nothing, and an anon-keyed server silently reads back empty tables and
# fails every write. Never expose this key to the browser or commit it.
# SUPABASE_URL falls back to VITE_SUPABASE_URL when unset.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Check which key the running server picked up: GET /api/health/db

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_REQUIRE_SUPABASE_AUTH=false

# -----------------------------------------------------------------------------
# AI Provider Configuration (all optional)
# -----------------------------------------------------------------------------
# Every AI endpoint has a deterministic fallback, so the app is fully functional
# with no keys set — recommendations, optimization, conflict detection, intent
# parsing and Excel header mapping all still work, just without an LLM.
# AI_DEFAULT_PROVIDER selects which provider is used when a key is available:
# openai | anthropic | google | deepseek | groq | ollama
AI_DEFAULT_PROVIDER=openai

# Optional: override the default model for the selected provider.
# AI_MODEL=claude-opus-5

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Base URL for a local Ollama server, e.g. http://localhost:11434
OLLAMA_BASE_URL=

# -----------------------------------------------------------------------------
# Error Tracking & Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Notification Channels (Optional)
# -----------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_TEAMS_WEBHOOK_URL=
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_SMS_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Shared Memory Configuration
# -----------------------------------------------------------------------------
SHARED_MEMORY_PERSIST_INTERVAL=30000
SHARED_MEMORY_CLEANUP_INTERVAL=60000
SHARED_MEMORY_MAX_HISTORY=10000
SHARED_MEMORY_NAMESPACE=nicu-schedule

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=100
